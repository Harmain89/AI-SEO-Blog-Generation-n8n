# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL (Sequelize) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=automated_seo_blog_db
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# ── CORS ────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Secret shared with the n8n workflow (ingest endpoint) ─
# Generate a long random string and use the SAME value in the
# n8n HTTP Request node header:  X-Ingest-Token
INGEST_TOKEN=change-me-to-a-long-random-secret
